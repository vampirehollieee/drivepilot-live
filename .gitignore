# Private configuration and runtime data
.env
.env.*
config/*
!config/
!config/*.example.txt
live-system/notification_config.json
live-system/place_aliases.json
live-data/
logs/

# Runtime outputs and sensitive artifacts
*.jsonl
*.csv
*.log
*.db
*.sqlite
*.sqlite3
*.key
*.pem
*.p12
*.bak
*backup*
*_backup*

# Keep sanitized demo data examples public
!demo-data/
!demo-data/*.jsonl
!demo-data/*.csv
!demo-data/*.json
!docs/demo-data/
!docs/demo-data/*.json

# Local caches and build outputs
__pycache__/
*.pyc
node_modules/
venv/
.venv/
tmp/
temp/
runtime/
build/
dist/
.codex/
.agents/

# OS/editor noise
Thumbs.db
Desktop.ini
